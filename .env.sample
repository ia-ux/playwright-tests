BROWSERSTACK_USERNAME="<retrieve_from_browserstack_account>"
BROWSERSTACK_ACCESS_KEY="<retrieve_from_browserstack_account>"

# Optional: leave the admin credentials empty to skip admin-only tests.
ARCHIVE_EMAIL="<priv_email>"
ARCHIVE_PASSWORD="<priv_password>"
PATRON_EMAIL="<reg_email>"
PATRON_PASSWORD="<reg_password>"

CATEGORY="all"

IS_REVIEW_APP=true
BASE_URL=""
BETA_ACCESS_TOKEN=""

# Set to true to run the real-upload test, which creates a test item on archive.org.
RUN_REAL_UPLOAD=false
